# Copy to web.env on the POS host (never commit it) and `chmod 600 web.env`.
# auto_deploy.sh starts the website connector only when web.env exists and is
# readable by its owner alone.
#
# The site the connector works on, and the site user it works as (an application password).
# That user needs the site permissions each listed ability checks.
WEB_SITE_URL=https://www.example.com
WEB_SITE_USER=connector-bot
WEB_SITE_APP_PASSWORD=
# Comma-separated ability names: every user with website access may call these.
WEB_ABILITIES=woocommerce/orders-query
# Comma-separated ability names only a Website Connector Manager (or System Manager) may call.
WEB_ABILITIES_RESTRICTED=
# Comma-separated write abilities, for a Website Connector Manager (or System Manager) only.
# Empty: the connector is read-only.
WEB_ABILITIES_WRITE=
#
# Write abilities that can be listed, by plugin (check each against the site's own list,
# /wp-json/wp-abilities/v1/abilities, since names vary between plugin versions):
#   WooCommerce: woocommerce/order-add-note (customer_note true emails the customer),
#     woocommerce/order-update-status, woocommerce/product-create,
#     woocommerce/product-update, woocommerce/product-delete
#   Store SEO: osa-seo/set-meta, osa-seo/bulk-set-meta, osa-seo/update-product,
#     osa-seo/bulk-optimize-products, osa-seo/update-settings
#   FluentCRM: fluent-crm/upsert-contact, fluent-crm/bulk-upsert-contacts,
#     fluent-crm/delete-contact, fluent-crm/apply-segments-to-contacts,
#     fluent-crm/manage-tag, fluent-crm/manage-list, fluent-crm/add-contact-note,
#     fluent-crm/delete-contact-note, fluent-crm/send-test-email,
#     fluent-crm/send-email-to-contact, fluent-crm/upsert-campaign,
#     fluent-crm/change-campaign-status, fluent-crm/update-contact-automation-status
