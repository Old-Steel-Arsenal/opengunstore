# Copy to web.env on the POS host (never commit it) and `chmod 600 web.env`.
# auto_deploy.sh starts the website read-only connector only when web.env exists
# and is readable by its owner alone.
#
# The site the connector reads, and the site user it reads as (an application password).
WEB_SITE_URL=https://www.example.com
WEB_SITE_USER=connector-bot
WEB_SITE_APP_PASSWORD=
# Comma-separated ability names: every user with website access may call these.
WEB_ABILITIES=woocommerce/orders-query
# Comma-separated ability names only a Website Connector Manager (or System Manager) may call.
WEB_ABILITIES_RESTRICTED=
