deploy/prod/.env
# website connector credentials (deploy/prod/mcp/web.env.example)
deploy/prod/mcp/web.env
deploy/prod/backups/
# Old demo-kit inventory exports held real serial numbers: never commit them, even though the kit is gone
deploy/demo/demo-data/
deploy/demo/*.json
/demo-data/

# Local-only secrets (FastBound dev UI login, etc.)
.secrets/

# Vendor reference docs (keep local; not source)
*.pdf
RSR DirectConnect Manual.pdf

# Local AI-assistant and editor notes — kept per developer, never committed
/CLAUDE.md
/AGENTS.md
/.claude/
/.agents/
/.codex/
/.mcp.json

# Third-party API specs: fetch with scripts/fetch_fastbound_spec.sh, don't commit
docs/fastbound/*.json
